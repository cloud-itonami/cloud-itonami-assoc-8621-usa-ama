;; The AMA source catalog, as Kotoba.
;;
;; GENERATED from data/datascript-tx.edn, which src/association/facts.kotoba
;; holds as the same catalog. Both are the same facts; this one reaches the
;; Kotoba oracle, wasm and both native ISAs, which the Clojure side cannot.
;;
;; `:topic` is a SET in the source. A set has no order and `topic` is
;; indexed by position, so the generator uses the order the data file
;; writes. `by-topic-id` answers by name and is unaffected.
;;
;; Not every entry carries every field. Two of the six cite pages that state
;; no founding year, and only one states a revision date, so `entry-field`
;; answers `none` for those -- an absent citation date is a fact about the
;; page, not a hole to be filled.
;;
;; Parity: test/association_facts_kotoba_parity_test compares every field of
;; every entry against the Clojure catalog, so this file cannot drift from
;; the data without the suite saying so.

(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [a :string] :bool (string=? a "ama"))

(defn entry-count [a :string] :i64 (if (association-covered? a) 6 0))

(defn valid-entry? [a :string i :i64] :bool
  (if (association-covered? a) (if (< i 0) false (< i 6)) false))

(defn entry-field [a :string i :i64 f :string] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0)
      (cond
        (string=? f "id") (option-some-of [:option :string] "ama.ama-history")
        (string=? f "title") (option-some-of [:option :string] "AMA History")
        (string=? f "association") (option-some-of [:option :string] "ama")
        (string=? f "isic") (option-some-of [:option :string] "8621")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://www.ama-assn.org/about/ama-history/ama-history")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1847")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string])
        )
      (= i 1)
      (cond
        (string=? f "id") (option-some-of [:option :string] "ama.code-of-medical-ethics")
        (string=? f "title") (option-some-of [:option :string] "Code of Medical Ethics")
        (string=? f "association") (option-some-of [:option :string] "ama")
        (string=? f "isic") (option-some-of [:option :string] "8621")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.ama-assn.org/about/ethics/why-does-medical-profession-need-code-ethics")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1847")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-07-16")
        :else (option-none-of [:option :string])
        )
      (= i 2)
      (cond
        (string=? f "id") (option-some-of [:option :string] "ama.principles-of-medical-ethics")
        (string=? f "title") (option-some-of [:option :string] "AMA Principles of Medical Ethics")
        (string=? f "association") (option-some-of [:option :string] "ama")
        (string=? f "isic") (option-some-of [:option :string] "8621")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://code-medical-ethics.ama-assn.org/principles")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "1957-06")
        (string=? f "last-revised-date") (option-some-of [:option :string] "2001-06")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-10")
        :else (option-none-of [:option :string])
        )
      (= i 3)
      (cond
        (string=? f "id") (option-some-of [:option :string] "ama.declaration-of-professional-responsibility")
        (string=? f "title") (option-some-of [:option :string] "AMA Declaration of Professional Responsibility")
        (string=? f "association") (option-some-of [:option :string] "ama")
        (string=? f "isic") (option-some-of [:option :string] "8621")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "self-regulatory-code")
        (string=? f "url") (option-some-of [:option :string] "https://www.ama-assn.org/delivering-care/ethics/ama-declaration-professional-responsibility")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "established-date") (option-some-of [:option :string] "2001-12-04")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-10")
        :else (option-none-of [:option :string])
        )
      (= i 4)
      (cond
        (string=? f "id") (option-some-of [:option :string] "ama.council-ethical-judicial-affairs")
        (string=? f "title") (option-some-of [:option :string] "Council on Ethical & Judicial Affairs (CEJA)")
        (string=? f "association") (option-some-of [:option :string] "ama")
        (string=? f "isic") (option-some-of [:option :string] "8621")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "governance-program")
        (string=? f "url") (option-some-of [:option :string] "https://www.ama-assn.org/councils/council-ethical-judicial-affairs")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-10")
        :else (option-none-of [:option :string])
        )
      :else
      (cond
        (string=? f "id") (option-some-of [:option :string] "ama.cpt")
        (string=? f "title") (option-some-of [:option :string] "CPT® (Current Procedural Terminology)")
        (string=? f "association") (option-some-of [:option :string] "ama")
        (string=? f "isic") (option-some-of [:option :string] "8621")
        (string=? f "country") (option-some-of [:option :string] "USA")
        (string=? f "kind") (option-some-of [:option :string] "professional-standard")
        (string=? f "url") (option-some-of [:option :string] "https://www.ama-assn.org/practice-management/cpt")
        (string=? f "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? f "retrieved-at") (option-some-of [:option :string] "2026-09-10")
        :else (option-none-of [:option :string])
        )
      )
    (option-none-of [:option :string])))

(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (if (= i 0) 1 2)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0)
      (if (= t 0) (option-some-of [:option :string] "governance") (option-none-of [:option :string]))
      (= i 1)
      (if (= t 0) (option-some-of [:option :string] "ethics")
        (if (= t 1) (option-some-of [:option :string] "medical-ethics") (option-none-of [:option :string])))
      (= i 2)
      (if (= t 0) (option-some-of [:option :string] "ethics")
        (if (= t 1) (option-some-of [:option :string] "governance") (option-none-of [:option :string])))
      (= i 3)
      (if (= t 0) (option-some-of [:option :string] "ethics")
        (if (= t 1) (option-some-of [:option :string] "professional-responsibility") (option-none-of [:option :string])))
      (= i 4)
      (if (= t 0) (option-some-of [:option :string] "governance")
        (if (= t 1) (option-some-of [:option :string] "ethics") (option-none-of [:option :string])))
      :else
      (if (= t 0) (option-some-of [:option :string] "coding")
        (if (= t 1) (option-some-of [:option :string] "professional-standard") (option-none-of [:option :string])))
      )
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "governance") 3
      (string=? candidate "ethics") 4
      (string=? candidate "medical-ethics") 1
      (string=? candidate "professional-responsibility") 1
      (string=? candidate "coding") 1
      (string=? candidate "professional-standard") 1
      :else 0
      )
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (cond
        (string=? candidate "governance") (entry-field a 0 "id")
        (string=? candidate "ethics") (entry-field a 1 "id")
        (string=? candidate "medical-ethics") (entry-field a 1 "id")
        (string=? candidate "professional-responsibility") (entry-field a 3 "id")
        (string=? candidate "coding") (entry-field a 5 "id")
        (string=? candidate "professional-standard") (entry-field a 5 "id")
        :else (option-none-of [:option :string])
        )
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-8621-usa-ama Wave 0 (ADR-2607141700): 6 ama entries seeded with an official citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
